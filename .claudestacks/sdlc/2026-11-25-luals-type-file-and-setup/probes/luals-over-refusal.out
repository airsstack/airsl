$ sh luals-map-case.sh airsl W files_lua '{"files.associations": {"*.x": "lua"}, "Lua": {"files": {"associations": {"*.y": "lua"}}}}' yes
## files_lua  .luarc.json before: {"files.associations": {"*.x": "lua"}, "Lua": {"files": {"associations": {"*.y": "lua"}}}}
